# คัดลอกเป็น .env.local สำหรับพัฒนาท้องถิ่น
# บน Vercel: Project → Settings → Environment Variables
# (อย่า commit ไฟล์ .env / .env.local)

# --- จำเป็นบน Vercel (Production + Preview) ---
# ต้องมีตอน build เพราะเป็น NEXT_PUBLIC_* (ฝังตอน build)
NEXT_PUBLIC_APP_URL=https://qr.9zahub.com

# --- ไม่บังคับ ---
# ค่าเริ่มต้นในโค้ด = trust proxy อยู่แล้ว (≠ "false")
# บน Vercel ไม่ต้องตั้งก็ได้ — ตั้ง true ก็ไม่เสียหาย
# ตั้ง false เฉพาะตอน dev ท้องถิ่นโดยไม่มี reverse proxy
# TRUST_PROXY=true
